# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env in your root or backend directory for local development.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# MongoDB Connection String
# Local fallback: mongodb://127.0.0.1:27017/ecommerce_dev
# Atlas cluster example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_dev

# Session Secret (Minimum 32 characters for production)
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_chars!

# OTP Keyed Hash Secret (Used for HMAC-SHA256 digest of 6-digit OTPs)
OTP_SECRET=dev_otp_hmac_secret_key_minimum_32_characters_long!

# Frontend URL (For CORS Whitelist)
FRONTEND_URL=http://localhost:5173

# Vite Frontend API Base URL (Used by frontend/.env)
VITE_API_URL=http://localhost:5000/api/v1
