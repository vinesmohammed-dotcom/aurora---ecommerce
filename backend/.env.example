# ==============================================================================
# Aurora E-Commerce Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit real secrets or credentials to version control.

# Application Environment
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String
# Example: mongodb://127.0.0.1:27017/ecommerce_dev
# Local Docker (connecting to host MongoDB): mongodb://host.docker.internal:27017/ecommerce_dev
# Production Replica Set: mongodb+srv://<user>:<password>@cluster.mongodb.net/ecommerce_prod
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_dev

# Session Management & Cryptographic Secrets (Min 32 characters for production)
SESSION_SECRET=dev_session_secret_replace_in_production_min_32_chars!
OTP_SECRET=dev_otp_hmac_secret_key_minimum_32_characters_long!

# Frontend Client URL (Used for CORS and CSRF Origin Header Verification)
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials (Test or Production)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# AWS Cloud Integration Settings (Optional/Production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=aurora-media-assets
AWS_SES_FROM_EMAIL=noreply@aurora-store.example.com
